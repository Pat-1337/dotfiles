typeset -U path PATH

path=(
  $HOME/Developer/bin
  $HOME/.cargo/bin
  $HOME/.local/bin
  $path
)

export PNPM_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/pnpm"
path=($PNPM_HOME/bin $path)

if [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv zsh)"
  path=(${path:#/home/linuxbrew/.linuxbrew/*} /home/linuxbrew/.linuxbrew/bin /home/linuxbrew/.linuxbrew/sbin)
fi

is_omarchy=0
[ -d /usr/share/omarchy ] || [ -d "$HOME/.local/share/omarchy" ] && is_omarchy=1

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
(( is_omarchy )) && (( $+commands[starship] )) && ZSH_THEME=""
plugins=(git uv zsh-syntax-highlighting zsh-autosuggestions)
(( $+commands[virtualenvwrapper.sh] )) && plugins+=(virtualenvwrapper)
zstyle ':omz:update' mode auto
zstyle ':omz:update' frequency 31
[ -r $ZSH/oh-my-zsh.sh ] && source $ZSH/oh-my-zsh.sh

if (( is_omarchy )); then
  [ -r "$HOME/.config/zsh/omarchy.zsh" ] && source "$HOME/.config/zsh/omarchy.zsh"
  [ -z "$ZSH_THEME" ] && [ "$TERM" != dumb ] && eval "$(starship init zsh)"
fi

export LANG=en_US.UTF-8
export EDITOR='vim'
export SUDO_EDITOR="$EDITOR"

command -v mise >/dev/null && eval "$(mise activate zsh)"
command -v fzf >/dev/null && eval "$(fzf --zsh)"
command -v atuin >/dev/null && eval "$(atuin init zsh)"

command -v thefuck >/dev/null && fuck() { unfunction fuck; eval "$(thefuck --alias)"; fuck "$@" }

alias zshrc='nano ~/.zshrc && source ~/.zshrc'
alias py='python3'
alias update='topgrade'
(( is_omarchy )) || alias open='xdg-open'
if [ -n "$WAYLAND_DISPLAY" ]; then
  alias pbcopy='wl-copy'
  alias pbpaste='wl-paste'
else
  alias pbcopy='xclip -selection clipboard'
  alias pbpaste='xclip -selection clipboard -o'
fi

alias dprune='docker system df && docker system prune -af && docker system df'

0x0() { curl -F "file=@$1" https://0x0.st }

secrets() {
  local f="$HOME/.secrets"
  [ -f "$f" ] || printf '# Sourced by ~/.zshrc — API keys and tokens. Edit with: secrets\n' > "$f"
  local -a ed=(${=EDITOR:-vim})
  case ${ed[1]} in
    mvim|gvim) ed+=(-f) ;;
    code|zed|subl) ed+=(--wait) ;;
  esac
  chmod 600 "$f" || return
  { "${ed[@]}" "$f" } always { chmod 400 "$f" }
  setopt localoptions allexport
  source "$f"
}
[ -s "$HOME/.secrets" ] && { setopt allexport; source "$HOME/.secrets"; unsetopt allexport }

[ -r "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"
unset is_omarchy
