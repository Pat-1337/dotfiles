# Tie the compiler search paths to arrays. They then hold no duplicate, and no
# empty entry from a trailing colon, which a compiler reads as the current
# directory. Re-sourcing this file is safe.
typeset -U path PATH
typeset -TU CPATH cpath
typeset -TU LIBRARY_PATH library_path
typeset -TU DYLD_LIBRARY_PATH dyld_library_path
typeset -TU PKG_CONFIG_PATH pkg_config_path

brew_prefix=/opt/homebrew

path=(
  $HOME/Developer/bin
  $brew_prefix/bin
  $brew_prefix/sbin
  $brew_prefix/opt/llvm/bin
  $brew_prefix/opt/sqlite/bin
  $brew_prefix/opt/libpq/bin
  $HOME/.surrealdb
  $HOME/.local/bin
  $HOME/.cargo/bin
  /usr/local/sbin
  $path
  /Applications/Obsidian.app/Contents/MacOS
)

# pnpm keeps its global binaries outside the node install
export PNPM_HOME="$HOME/Library/pnpm"
path=($PNPM_HOME/bin $path)

# The prompt for a shell that has no oh-my-zsh theme
PS1="%m:%~ %n λ "

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="eastwood"
plugins=(git macos iterm2 virtualenvwrapper zsh-syntax-highlighting zsh-autosuggestions)
zstyle ':omz:update' mode auto
zstyle ':omz:update' frequency 31
source $ZSH/oh-my-zsh.sh

export LANG=en_US.UTF-8
export ARCHFLAGS="-arch arm64"
export MONO_GAC_PREFIX="$brew_prefix"
export LDFLAGS="-L$brew_prefix/opt/llvm/lib -L$brew_prefix/opt/sqlite/lib"
export CPPFLAGS="-I$brew_prefix/opt/llvm/include -I$brew_prefix/opt/sqlite/include"

cpath=($brew_prefix/include $cpath)
library_path=($brew_prefix/lib $library_path)
dyld_library_path=($brew_prefix/opt/sqlite/lib $brew_prefix/opt/poppler/lib $brew_prefix/lib $dyld_library_path)
pkg_config_path=($brew_prefix/opt/sqlite/lib/pkgconfig $pkg_config_path)
export CPATH LIBRARY_PATH DYLD_LIBRARY_PATH PKG_CONFIG_PATH

# mise manages node/pnpm/bun/go (see ~/.config/mise/config.toml); uv manages python
command -v mise >/dev/null && eval "$(mise activate zsh)"
command -v fzf >/dev/null && eval "$(fzf --zsh)"
command -v atuin >/dev/null && eval "$(atuin init zsh)"
command -v uv >/dev/null && eval "$(uv generate-shell-completion zsh)"
[ -s "$HOME/.config/envman/load.sh" ] && source "$HOME/.config/envman/load.sh"
[ -s "$HOME/.iterm2_shell_integration.zsh" ] && source "$HOME/.iterm2_shell_integration.zsh"

# thefuck starts a python interpreter, so pay for it at the first call instead
command -v thefuck >/dev/null && fuck() { unfunction fuck; eval "$(thefuck --alias)"; fuck "$@" }

[[ -n $SSH_CONNECTION ]] && EDITOR=vim || EDITOR=mvim
export EDITOR

alias zshrc='nano ~/.zshrc && source ~/.zshrc'
alias vimrc='vim ~/.vimrc'
alias py='python3'
alias update='topgrade'
alias xcode='rm -rf ~/Library/Developer/Xcode/DerivedData/*'
alias quar='xattr -d com.apple.quarantine'
alias deletebranches='git branch | grep -v "dev" | grep -v "master" | xargs git branch -D'
alias ccat='bat'

# Volumes stay, because database data lives there. Add --volumes to drop them.
alias dprune='docker system df && docker system prune -af && docker system df'

0x0() { curl -F "file=@$1" https://0x0.st }

# ~/.secrets is read-only. This unlocks it for one edit, then re-locks it.
secrets() {
  local f="$HOME/.secrets"
  [ -f "$f" ] || printf '# Sourced by ~/.zshrc — API keys and tokens. Edit with: secrets\n' > "$f"
  local -a ed=(${=EDITOR:-vim})
  # A GUI editor returns at once, which would re-lock the file mid-edit
  case ${ed[1]} in
    mvim|gvim) ed+=(-f) ;;
    code|zed|subl) ed+=(--wait) ;;
  esac
  chmod 600 "$f" || return
  { "${ed[@]}" "$f" } always { chmod 400 "$f" }
  source "$f"
}
[ -s "$HOME/.secrets" ] && source "$HOME/.secrets"
