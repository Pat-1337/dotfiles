### Custom ###

# Dedupe PATH entries automatically
typeset -U path PATH

# PATH
path=(
  $HOME/Developer/bin
  /opt/homebrew/bin
  /opt/homebrew/sbin
  /opt/homebrew/opt/llvm/bin
  /opt/homebrew/opt/sqlite/bin
  /opt/homebrew/opt/libpq/bin
  $HOME/.surrealdb
  $HOME/.local/bin
  $HOME/.cargo/bin
  /usr/local/sbin
  $path
  /Applications/Obsidian.app/Contents/MacOS
)

# Prompt for non-omz
export PS1="%m:%~ %n λ "

# Oh My Zsh
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="eastwood"
plugins=(git macos iterm2 virtualenvwrapper zsh-syntax-highlighting zsh-autosuggestions)
zstyle ':omz:update' mode auto
zstyle ':omz:update' frequency 31
source $ZSH/oh-my-zsh.sh

export LANG=en_US.UTF-8

# Build flags — Apple Silicon Homebrew lives in /opt/homebrew
export LDFLAGS="-L/opt/homebrew/opt/llvm/lib -L/opt/homebrew/opt/sqlite/lib"
export CPPFLAGS="-I/opt/homebrew/opt/llvm/include -I/opt/homebrew/opt/sqlite/include"
export PKG_CONFIG_PATH="/opt/homebrew/opt/sqlite/lib/pkgconfig"
export CPATH="/opt/homebrew/include:$CPATH"
export LIBRARY_PATH="/opt/homebrew/lib:$LIBRARY_PATH"
export DYLD_LIBRARY_PATH="/opt/homebrew/opt/sqlite/lib:/opt/homebrew/opt/poppler/lib:/opt/homebrew/lib:$DYLD_LIBRARY_PATH"
export MONO_GAC_PREFIX="/opt/homebrew"
export ARCHFLAGS="-arch arm64"

# Tools
# mise manages node/bun/go (see ~/.config/mise/config.toml); uv manages python
command -v mise >/dev/null && eval "$(mise activate zsh)"
command -v thefuck >/dev/null && eval "$(thefuck --alias)"
command -v fzf >/dev/null && eval "$(fzf --zsh)"
command -v atuin >/dev/null && eval "$(atuin init zsh)"
command -v uv >/dev/null && eval "$(uv generate-shell-completion zsh)"
[ -s "$HOME/.config/envman/load.sh" ] && source "$HOME/.config/envman/load.sh"
[ -s "$HOME/.iterm2_shell_integration.zsh" ] && source "$HOME/.iterm2_shell_integration.zsh"

# Preferred editor for local and remote sessions
[[ -n $SSH_CONNECTION ]] && export EDITOR='vim' || export EDITOR='mvim'

# Aliases
alias zshrc='nano ~/.zshrc && source ~/.zshrc'
alias vimrc='vim ~/.vimrc'
alias py='python3'
alias update='topgrade'
alias xcode='rm -rf ~/Library/Developer/Xcode/DerivedData/*'
alias quar='xattr -d com.apple.quarantine'
alias deletebranches='git branch | grep -v "dev" | grep -v "master" | xargs git branch -D'
alias ccat='bat'

# Docker: reclaim disk. Removes all unused images, stopped containers, unused
# networks and the build cache. Volumes stay: database data lives there.
# To delete volumes too, run: docker system prune -af --volumes
alias dprune='docker system df && docker system prune -af && docker system df'

# 0x0.st
0x0() { curl -F "file=@$1" https://0x0.st; }

# Secrets
# ~/.secrets is read-only; `secrets` unlocks it for one edit, then re-locks it
secrets() {
  local f="$HOME/.secrets"
  [ -f "$f" ] || printf '# Sourced by ~/.zshrc — API keys and tokens. Edit with: secrets\n' > "$f"
  local -a ed=(${=EDITOR:-vim})
  # GUI editors return immediately, which would re-lock the file mid-edit
  case ${ed[1]} in
    mvim|gvim) ed+=(-f) ;;
    code|zed|subl) ed+=(--wait) ;;
  esac
  chmod 600 "$f" || return
  { "${ed[@]}" "$f" } always { chmod 400 "$f" }
  source "$f"
}
[ -s "$HOME/.secrets" ] && source "$HOME/.secrets"
