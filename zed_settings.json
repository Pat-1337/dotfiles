{
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "confirm_quit": true,
  "agent": {
    "dock": "right",
    "default_model": {
      "effort": "high",
      "enable_thinking": true,
      "provider": "anthropic",
      "model": "claude-opus-5"
    }
  },
  "base_keymap": "JetBrains",
  "telemetry": {
    "diagnostics": true,
    "metrics": false
  },
  "performance": {
    "show_in_status_bar": true
  },
  "terminal": {
    "detect_venv": "off"
  },
  "icon_theme": {
    "mode": "light",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "theme": {
    "mode": "light",
    "light": "Solarized Light",
    "dark": "One Dark"
  },
  "buffer_font_size": 15,
  "vim_mode": true,
  "relative_line_numbers": "enabled",
  "vim": {
    "use_smartcase_find": true
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 5000
    }
  },
  "git": {
    "git_gutter": "tracked_files",
    "inline_blame": {
      "enabled": true
    }
  },
  "inlay_hints": {
    "enabled": true,
    "show_type_hints": true,
    "show_parameter_hints": true,
    "show_other_hints": true,
    "edit_debounce_ms": 700,
    "scroll_debounce_ms": 50
  },
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "check": {
          "command": "clippy"
        }
      }
    },
    "ruff": {
      "initialization_options": {
        "settings": {
          "lineLength": 120,
          "lint": {
            "extendSelect": ["I"]
          }
        }
      }
    },
    "ty": {
      "settings": {
        "diagnosticMode": "workspace",
        "inlayHints": {
          "variableTypes": true,
          "callArgumentNames": true
        }
      }
    }
  },
  "languages": {
    "Python": {
      "language_servers": ["ty", "ruff"],
      "format_on_save": "off",
      "formatter": [
        { "code_action": "source.organizeImports.ruff" },
        { "code_action": "source.fixAll.ruff" },
        {
          "language_server": {
            "name": "ruff"
          }
        }
      ]
    }
  }
}
